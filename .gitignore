# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local environment (NEVER commit real keys)
.env

# Outputs (only the latest/ marker is tracked, generated files are not)
outputs/latest/*.json
outputs/latest/*.html
outputs/latest/*.mp4
outputs/latest/*.txt
outputs/latest/audio/
outputs/latest/narration_manifest.json
outputs/latest/*.wav
outputs/latest/*.mp3
outputs/latest/*.aac
outputs/latest/*.m4a

# Job outputs (only .gitkeep is tracked, job_* dirs are generated)
outputs/jobs/*
!outputs/jobs/.gitkeep

# Episode preview HTML artifacts (CP31)
outputs/episode_previews/*.html
!outputs/episode_previews/.gitkeep

# Episode export artifacts (CP40.2)
outputs/episode_exports/*
!outputs/episode_exports/.gitkeep

# Prototype / temp export artifacts (CP40.1)
.tmp/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
