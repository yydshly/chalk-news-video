{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "semantic_ir",
  "description": "Formal semantic_ir contract for chalk-news-video (schema_version 0.1). LLM must NOT output coordinates.",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "structure_type",
    "title",
    "nodes",
    "edges",
    "callouts",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+$",
      "description": "Contract version. Current: 0.1."
    },
    "meta": {
      "type": "object",
      "description": "Provenance and language metadata.",
      "additionalProperties": false,
      "required": ["lang"],
      "properties": {
        "source_title": {"type": "string"},
        "source_url": {"type": "string"},
        "source_name": {"type": "string"},
        "published_at": {"type": ["string", "null"]},
        "lang": {"type": "string", "description": "BCP-47-ish, e.g. 'zh', 'en'."}
      }
    },
    "structure_type": {
      "type": "string",
      "enum": ["causal_chain"],
      "description": "Only causal_chain supported in 0.1."
    },
    "title": {
      "type": "string",
      "description": "Headline displayed at the top."
    },
    "summary": {
      "type": "string",
      "description": "One-line summary shown under the title."
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "Unique node id, e.g. 'n1'."},
          "label": {"type": "string"},
          "sub": {"type": ["string", "null"], "description": "Optional secondary line."},
          "role": {"type": "string", "enum": ["source", "target", "neutral"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "Unique edge id, e.g. 'e1'."},
          "from": {"type": "string", "description": "Source node id."},
          "to": {"type": "string", "description": "Target node id."},
          "label": {"type": ["string", "null"]}
        }
      }
    },
    "callouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "on", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "on": {"type": "string", "description": "Node id this callout is attached to."},
          "text": {"type": "string"},
          "tone": {"type": "string", "enum": ["info", "alert", "positive"]}
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered reveal sequence. Each beat has reveal + narration.",
      "items": {
        "type": "object",
        "required": ["id", "reveal", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "reveal": {
            "type": "string",
            "description": "What this beat reveals: 'title', a node id, an edge id, or a callout id."
          },
          "narration": {"type": "string"}
        }
      }
    }
  }
}
