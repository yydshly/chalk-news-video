# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# chalk-news-video reads these via `os.environ` (after `load_env_file`).
#
# --- MiniMax (Anthropic Messages style) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=                  # e.g. https://api.MiniMax.example/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# --- Mimo (OpenAI-compatible) ---
MIMO_API_KEY=
MIMO_BASE_URL=                     # e.g. https://api.Mimo.example/v1
MIMO_MODEL=
