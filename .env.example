# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# chalk-news-video reads these via `os.environ` (after `load_env_file`).
# Environment variables always override llm.yaml static values.

# ===== MiniMax OpenAI-compatible =====
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ===== MiniMax Anthropic-compatible (optional) =====
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# ===== MiMo pay-as-you-go OpenAI-compatible =====
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ===== MiMo Token Plan OpenAI-compatible (optional) =====
# Uncomment and set to token-plan base URL when using Token Plan:
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_API_KEY=tp-xxxxx

# ===== MiniMax TTS (optional, for CP6+) =====
# Fill in when using real MiniMax TTS. Do NOT hardcode endpoint.
# MINIMAX_TTS_BASE_URL=
# MINIMAX_TTS_ENDPOINT_PATH=
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_TTS_VOICE_ID=
